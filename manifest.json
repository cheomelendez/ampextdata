{
  "manifest_version": 3,
  "name": "AMP Extractor",
  "description": "Sync Amazon Logistics routes, driver itineraries, schedules, and work summaries to your AMP account.",
  "version": "1.0",
  "permissions": ["tabs", "scripting", "debugger"],
  "host_permissions": [
    "https://logistics.amazon.com/*",
    "https://recon.amngtpro.com/*"
  ],
  "icons": {
    "128": "extract.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AMP Extractor — start a sync from the AMP app",
    "default_icon": {
      "128": "extract.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://recon.amngtpro.com/*"],
      "js": ["content.js"]
    }
  ]
}
