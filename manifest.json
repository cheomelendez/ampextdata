{
  "manifest_version": 3,
  "name": "AMP Extractor",
  "version": "1.0",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://logistics.amazon.com/*",
    "https://recon.amngtpro.com/*",
    "https://candidate-dashboard-integration.free.beeceptor.com/*"
  ],
  "icons": {
    "128": "extract.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Run Extraction",
    "default_icon": {
      "128": "extract.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
